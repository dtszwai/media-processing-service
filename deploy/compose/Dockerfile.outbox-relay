FROM golang:1.26-alpine AS build
WORKDIR /src
RUN apk add --no-cache git
COPY backend/go.mod backend/go.sum* ./
RUN go mod download || true
COPY backend/ .
ARG BUILD_VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.buildVersion=${BUILD_VERSION}" -o /out/outbox-relay ./cmd/workers/outbox-relay

FROM alpine:3.20
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 app
COPY --from=build /out/outbox-relay /usr/local/bin/outbox-relay
USER app
ENTRYPOINT ["/usr/local/bin/outbox-relay"]
